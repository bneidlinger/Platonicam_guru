# Copy to .env and adjust. All values optional; defaults suit local dev.

# Ollama endpoint (use http://ollama:11434 inside docker compose)
OLLAMA_HOST=http://localhost:11434

# Model overrides
#CHAT_MODEL=llama3.1:8b
#EMBEDDING_MODEL=nomic-embed-text

# API auth. Empty/unset = open access for local dev.
# Admin endpoints (/admin/*) stay disabled until this is set.
#PLATONICAM_API_KEY=change-me

# Comma-separated CORS origins ("*" for any)
#ALLOWED_ORIGINS=*

# Conversation session lifecycle
#SESSION_TTL_MINUTES=60
#MAX_SESSIONS=1000

# Server bind (used by run_api.py)
#API_HOST=0.0.0.0
#API_PORT=8000
